# Copiar a .env y completar localmente. Nunca subir .env, claves ni tokens.

# --- Snowflake (misma cuenta y clave RSA del PSet 2) ---
SNOWFLAKE_ACCOUNT=tu_organizacion-tu_cuenta
SNOWFLAKE_USER=tu_usuario_exacto
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2_DB
# Tabla OBT publicada por el pipeline del PSet 2.
SNOWFLAKE_OBT_TABLE=ANALYTICS.OBT_SALES
# Rutas a la clave privada y a su frase. Pueden apuntar a la carpeta .secrets
# del PSet 2 (ruta absoluta) para no duplicar secretos.
SNOWFLAKE_PRIVATE_KEY_FILE=../Pset2/.secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE_FILE=../Pset2/.secrets/snowflake_passphrase.txt
# Alternativa: la frase directamente (dejar vacío si se usa el archivo).
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- MLflow (docker-compose.yml) ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5050
MLFLOW_POSTGRES_PASSWORD=
# Nombre del experimento y del modelo registrado (<proyecto>-modelo).
MLFLOW_EXPERIMENT_NAME=favorita-perecederos

